import = [
  "~/.config/alacritty/themes/themes/ayu_dark.toml"
]

# https://github.com/alacritty/alacritty-theme

# https://alacritty.org/config-alacritty.html

[env]
TERM = "xterm-256color"

[font.normal]
family = "MesloLGS NF"

[[keyboard.bindings]]
action = "Paste"
key = "V"
mods = "Alt"

[[keyboard.bindings]]
action = "Copy"
key = "C"
mods = "Alt"

[scrolling]
history = 100000

[shell]
program = "/usr/bin/fish"
args = ["--login"]

[window]
# decorations = "none"
decorations = "Full"
dynamic_padding = false
opacity = 0.9

[window.dimensions]
columns = 100
lines = 30

[window.padding]
x = 5
y = 5
